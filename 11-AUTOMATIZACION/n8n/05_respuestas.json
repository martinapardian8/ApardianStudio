    {
      "parameters": {
        "jsCode": "const abiertos = ['enviado', 'seguimiento_1', 'seguimiento_2', 'borrador_seg1', 'borrador_seg2'];\nreturn $input.all().filter(r => r.json.thread_id && abiertos.includes(r.json.estado))\n  .map(r => ({ json: r.json }));\n"
      },
      "id": "1a590549-6e73-5148-914d-065f42a880f2",
      "name": "Con hilo abierto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/threads/{{ $json.thread_id }}?format=full",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {}
      },
      "id": "1fec5e1e-3ca0-5205-858a-c27517c2468c",
      "name": "Leer hilo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR",
          "name": "Gmail Apardian"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Busca el último mensaje del hilo que NO mandamos nosotros.\nconst yo = String($('Config').first().json.MI_DIRECCION || '').toLowerCase();\nconst leads = $('Con hilo abierto').all();\nconst dec = d => Buffer.from(String(d || '').replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8');\nconst textoPlano = p => {\n  if (!p) return '';\n  if (p.mimeType === 'text/plain' && p.body && p.body.data) return dec(p.body.data);\n  for (const q of (p.parts || [])) { const t = textoPlano(q); if (t) return t; }\n  return '';\n};\nconst sinCita = t => t.split(/\\r?\\n(?:El .{5,120} escribió:|On .{5,120} wrote:|Em .{5,120} escreveu:)/)[0]\n  .split('\\n').filter(l => !l.startsWith('>')).join('\\n').trim();\nconst out = [];\n$input.all().forEach((it, i) => {\n  const lead = leads[i] ? leads[i].json : null;\n  if (!lead || it.json.error) return;\n  const ajenos = (it.json.messages || []).filter(m => {\n    const from = ((m.payload || {}).headers || []).find(h => /^from$/i.test(h.name));\n    return from && !String(from.value).toLowerCase().includes(yo);\n  });\n  if (!ajenos.length) return;\n  const m = ajenos[ajenos.length - 1];\n  const h = n => (((m.payload || {}).headers || []).find(x => x.name.toLowerCase() === n) || {}).value || '';\n  out.push({ json: { lead, de: h('from'), asunto: h('subject'),\n    texto: (sinCita(textoPlano(m.payload)) || m.snippet || '').slice(0, 4000) } });\n});\nreturn out;\n"
      },
      "id": "f5baf791-709f-5493-b551-58cae729cd05",
      "name": "¿Respondió?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function cuerpoClaude(system, user, maxTokens, effort) {\n  return {\n    model: 'claude-opus-5-5',\n    max_tokens: maxTokens,\n    system: system,\n    messages: [{ role: 'user', content: user }],\n    output_config: { effort: effort },\n    fallbacks: 'default',\n  };\n}\n\nconst SYSTEM = \"Clasificás respuestas a mails de prospección de APARDIAN STUDIO (fotografía,\\nvideo, páginas web y edición en Lightroom, Uruguay).\\n\\nRecibís el asunto y el texto de una respuesta. Elegí UNA categoría:\\n- \\\"interesado\\\": quiere saber más, acepta la idea, pide una llamada o ejemplos.\\n- \\\"pide_precio\\\": pregunta cuánto sale, pide presupuesto o tarifas.\\n- \\\"no_ahora\\\": no por ahora, más adelante, ya tiene algo pero no cierra la puerta.\\n- \\\"baja\\\": no le interesa, pide que no le escriban, se molesta. Ante la duda\\n  entre \\\"no_ahora\\\" y \\\"baja\\\", elegí \\\"baja\\\".\\n- \\\"rebote\\\": respuesta automática, fuera de oficina, error de entrega,\\n  dirección inexistente.\\n- \\\"otro\\\": cualquier otra cosa.\\n\\nAdemás escribí un resumen de una línea para Martin y, si es \\\"interesado\\\" o\\n\\\"pide_precio\\\", una sugerencia de respuesta corta en el tono de Martin (voseo,\\ndirecto, sin emojis), que él va a revisar antes de mandar. No inventes precios:\\nsi piden precio, la sugerencia propone una charla corta o pide 2 datos para\\ncotizar.\\n\\nRespondé SOLO con un objeto JSON válido:\\n{\\n  \\\"categoria\\\": \\\"interesado\\\",\\n  \\\"resumen\\\": \\\"\\\",\\n  \\\"sugerencia_respuesta\\\": \\\"\\\"\\n}\";\nconst usuario = 'De: ' + $json.de + '\\nAsunto: ' + $json.asunto + '\\n\\nRespuesta:\\n' + $json.texto;\nreturn { json: { ...$json, claude_body: cuerpoClaude(SYSTEM, usuario, 2000, 'low') } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "4d9a892e-2830-5601-9e78-26a66136ae11",
