      "id": "e4b5f8f4-d37c-57de-999f-f1757a367bc3",
      "name": "Claude · seguimiento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
