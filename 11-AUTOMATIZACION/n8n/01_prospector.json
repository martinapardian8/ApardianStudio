    {
      "parameters": {
        "jsCode": "// Rubro x ciudad. Agregá o sacá filas: cada una es una búsqueda en Google Maps.\n// Ojo: cada búsqueda trae hasta 20 negocios y cuesta (ver README, costos).\nconst rubros = [\n  { rubro: 'restaurante', q: 'restaurantes' },\n  { rubro: 'parrilla', q: 'parrillas' },\n  { rubro: 'cafe', q: 'cafeterías de especialidad' },\n  { rubro: 'salon', q: 'salones de eventos' },\n  { rubro: 'inmobiliaria', q: 'inmobiliarias' },\n  { rubro: 'marca', q: 'tienda de productos artesanales' },\n];\nconst ciudades = ['Pocitos, Montevideo', 'Carrasco, Montevideo', 'Ciudad Vieja, Montevideo',\n                  'Punta del Este', 'Ciudad de la Costa, Canelones'];\nconst out = [];\nfor (const r of rubros) for (const c of ciudades)\n  out.push({ json: { rubro: r.rubro, ciudad: c, query: r.q + ' en ' + c + ', Uruguay' } });\nreturn out;\n"
      },
      "id": "df4f152f-8350-5253-94c4-68a2082e35e1",
      "name": "Búsquedas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Goog-FieldMask",
              "value": "places.id,places.displayName,places.websiteUri,places.formattedAddress,places.rating,places.userRatingCount,places.nationalPhoneNumber,places.googleMapsUri"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ textQuery: $json.query, languageCode: 'es', regionCode: 'UY', pageSize: 20 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "1a63753b-6715-591c-a08c-6a5a220908fa",
      "name": "Google Places",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Google Places API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Una fila por negocio. Places devuelve una respuesta por búsqueda, en orden.\nconst busq = $('Búsquedas').all();\nconst out = [];\n$input.all().forEach((it, i) => {\n  const b = busq[i] ? busq[i].json : {};\n  for (const p of (it.json.places || [])) {\n    out.push({ json: {\n      id: p.id,\n      nombre: (p.displayName && p.displayName.text) || '',\n      web: p.websiteUri || '',\n      telefono: p.nationalPhoneNumber || '',\n      direccion: p.formattedAddress || '',\n      rating: p.rating || '',\n      reseñas: p.userRatingCount || 0,\n      maps: p.googleMapsUri || '',\n      rubro: b.rubro, ciudad: b.ciudad,\n    } });\n  }\n});\nreturn out;\n"
      },
      "id": "195b715d-abc0-55cb-8873-218eff618229",
      "name": "Aplanar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
